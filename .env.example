# ==========================================
# AI Interview Simulator - Environment Variables
# ==========================================
# Copy this file to .env and adjust values as needed.

# -----------------
# Backend Settings
# -----------------
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Allowed Frontend Origins (comma-separated if multiple, e.g. https://my-app.vercel.app,http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Database URL (Defaults to SQLite at database/interview.db if omitted)
# For production PostgreSQL: postgresql://user:password@host:port/dbname
# DATABASE_URL=

# -----------------
# Frontend Settings
# -----------------
# Leave empty during local development to use Vite's proxy (/api -> backend)
# In production, set to your deployed backend URL:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
VITE_API_BASE_URL=
